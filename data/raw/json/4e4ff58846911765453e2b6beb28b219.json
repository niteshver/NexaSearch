        "og:title": "Messier: A High-Resolution Corpus for Cross-Benchmark Agent Evaluation",
        "og:url": "https://arxiv.org/abs/2607.25891v1",
        "og:image": "/static/browse/0.3.4/images/arxiv-logo-fb.png",
