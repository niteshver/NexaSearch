        "og:site_name": "arXiv.org",
        "og:title": "Pictura: Perspective-View Self-Play at Scale for Driving",
        "og:url": "https://arxiv.org/abs/2607.26005v1",
        "og:image": "/static/browse/0.3.4/images/arxiv-logo-fb.png",
