        "og:title": "DynaBridge: Dynamic Summary-Guided Cross-Task Multimodal Fusion for DASS-Structured Mental Health Assessment",
        "og:url": "https://arxiv.org/abs/2607.25679v1",
        "og:image": "/static/browse/0.3.4/images/arxiv-logo-fb.png",
