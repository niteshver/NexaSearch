        "og:site_name": "arXiv.org",
        "og:title": "$π\\mathbf{R}^2$: Reactive Real-time Flow Policies",
        "og:url": "https://arxiv.org/abs/2607.26055v1",
        "og:image": "/static/browse/0.3.4/images/arxiv-logo-fb.png",
