        "og:title": "ArtiTwinSplat: Interactable Digital Twin Reconstruction via Gaussian Splatting from RGB-D videos",
        "og:url": "https://arxiv.org/abs/2606.24628v1",
        "og:image": "/static/browse/0.3.4/images/arxiv-logo-fb.png",
